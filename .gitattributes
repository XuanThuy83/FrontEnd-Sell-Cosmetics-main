 /* ====== Notify webhook (dán URL /exec + ?secret=...) ====== */
    const NOTIFY_URL = 'https://script.google.com/macros/s/AKfycbyyvlRX8jQ5t3hzXsra02LeT9PulJRU3X-sWfoR3xq1CcxlyPLCebB5VWH1dLEgHKF-cA/exec?secret=CHANGE_ME_32CHARS';
    function notify(orderObj){
  try{
    if(!NOTIFY_URL) return;
    fetch(NOTIFY_URL, {
      method: 'POST',
      // KHÔNG đặt headers để tránh preflight OPTIONS 405
      body: JSON.stringify(orderObj)
    })
    .then(r => r.text())        // không cần đọc JSON, chỉ để kích hoạt request
    .then(t => console.log('notify sent'))
    .catch(err => console.error('notify error =>', err));
  }catch(e){ console.error(e); }
}